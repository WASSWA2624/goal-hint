# Copy to ignored .env.local. Blank owner choices remain unresolved.
# Approved source-owned defaults are documented below.
# Next sets NODE_ENV itself; tests use explicitly supplied test configuration.
# NEXT_PUBLIC_* settings are rejected: publicPolicy is source-owned and nonsecret.
# No paid/provider operation, shadow run or publication is enabled by this file.
GOAL_HINT_OPERATION_SCOPE=disabled
# Request-time deployment classification; absent/unknown values keep indexing disabled.
# Production classification also requires source-owned release approval; draft notices have separate noindex controls.
GOAL_HINT_DEPLOYMENT_ENVIRONMENT=development
GOAL_HINT_DATABASE_ENABLED=false
GOAL_HINT_FOOTBALL_ENABLED=false
GOAL_HINT_AI_ENABLED=false
GOAL_HINT_RESEARCH_ENABLED=false

# Server-only credentials: obtain at the owning prompt; never commit real values.
# Prompt 003 verifies actual test-target isolation before any database cleanup.
DATABASE_URL=
TEST_DATABASE_URL=
MIGRATION_DATABASE_URL=

# MySQL only. Separate migration credentials have DDL; the app role has DML only.
# Local direct connections default to 5 lazy pooled connections with bounded waits.
# Remote/production targets need explicit approved connection mode and TLS.
# Production also requires an explicit pool limit and verified infrastructure cap.
GOAL_HINT_DATABASE_CONNECTION_MODE=
GOAL_HINT_DATABASE_POOL_LIMIT=
GOAL_HINT_DATABASE_CONNECT_TIMEOUT_MS=5000
GOAL_HINT_DATABASE_ACQUIRE_TIMEOUT_MS=10000
GOAL_HINT_DATABASE_IDLE_TIMEOUT_SECONDS=30
GOAL_HINT_DATABASE_TLS_MODE=
GOAL_HINT_DATABASE_TLS_CA_FILE=
GOAL_HINT_DATABASE_ACCESS_REF=

# Optional test-only MYSQL_TEST_SERVER_BINARY points to genuine MySQL mysqld.
# test:db otherwise discovers a standard local install; never uses MariaDB.
API_FOOTBALL_KEY=
AI_API_KEY=
RESEARCH_API_KEY=

# Direct Mega payable amount, including all taxes/charges, in integer US cents.
# Its fixed ceiling is 4500; no checkout/account/rights evidence is assumed (008).
API_FOOTBALL_PAYABLE_MONTHLY_USD_CENTS=
GOAL_HINT_COMPETITION_IDS=
GOAL_HINT_FOOTBALL_TRIAL_REQUEST_LIMIT=
GOAL_HINT_FOOTBALL_PRIVATE_USE_REF=
GOAL_HINT_FOOTBALL_ACCOUNT_EVIDENCE_REF=
GOAL_HINT_FOOTBALL_PUBLIC_RIGHTS_REF=

# Provider odds (052). Runner-only switches belong in the ignored .env.operations.
# Imports stay off unless enabled AND the verified plan leaves spare ordinary quota
# (never on Free or slow plans). One documented bookmaker id is required when on.
# Without a verified odds-rights reference, odds are stored privately and never shown.
GOAL_HINT_ODDS_IMPORT_ENABLED=false
GOAL_HINT_ODDS_BOOKMAKER_ID=
GOAL_HINT_FOOTBALL_ODDS_RIGHTS_REF=

# Team codes for tight phone cards (/teams?league&season). On by default, but the live
# runner spends only the same spare quota as odds, so imports stay off on Free and slow
# plans. Set false to keep them off on any plan. Runner-only; .env.operations works too.
GOAL_HINT_TEAM_CODES_IMPORT_ENABLED=true

# Separate explicitly approved monthly caps (010; infrastructure 003/020/046).
# Zero disables paid AI/research; a deliberate free infrastructure cap may be 0.
# Approval must cover these values, rates, time periods and itemized categories.
GOAL_HINT_AI_MONTHLY_BUDGET_USD_CENTS=
# Explicit usage-based billing removes only the monthly AI spending ceiling.
# Per-request token/time bounds and football quotas still apply.
GOAL_HINT_AI_BILLING_MODE=capped
GOAL_HINT_RESEARCH_MONTHLY_BUDGET_USD_CENTS=
GOAL_HINT_INFRASTRUCTURE_MONTHLY_BUDGET_USD_CENTS=
GOAL_HINT_BUDGET_APPROVAL_REF=

# Providers/configuration are owner choices; no model or research source chosen.
# CALIBRATION_REF records configuration, not a claim of measured calibration.
GOAL_HINT_AI_PROVIDER=
GOAL_HINT_AI_MODEL=
GOAL_HINT_CALIBRATION_REF=
GOAL_HINT_RESEARCH_PROVIDER=
GOAL_HINT_RESEARCH_LICENSE_REF=

# Approved regulation-markets-v1 probability tolerances (005).
# Blank values use these defaults; differing overrides require a new rule version.
# Policy records must define source/status freshness, minimum evidence, conflict
# handling and unknown provider update times. Referenced proof is verified later.
GOAL_HINT_PROBABILITY_SUM_TOLERANCE=0.001
GOAL_HINT_CONSISTENCY_TOLERANCE=0.002
GOAL_HINT_EVIDENCE_POLICY_REF=
GOAL_HINT_FRESHNESS_POLICY_REF=
GOAL_HINT_JOB_REQUEST_LIMIT=
GOAL_HINT_JOB_TOKEN_LIMIT=
GOAL_HINT_JOB_TIMEOUT_SECONDS=

# Bounded private shadow AI/research allowance; capped categories retain monthly caps.
# Shadow needs applicable private-use rights, budgets and pipeline integrity.
# It gathers quality evidence; it cannot publish production forecasts (014/047).
GOAL_HINT_SHADOW_MAX_JOBS=
GOAL_HINT_SHADOW_BUDGET_USD_CENTS=
GOAL_HINT_SHADOW_PROTOCOL_REF=
GOAL_HINT_PIPELINE_INTEGRITY_REF=

# Public production additionally requires measured quality, public rights and
# release evidence (047–049). A string/reference is not verification by itself.
GOAL_HINT_QUALITY_QUALIFICATION_REF=
GOAL_HINT_RELEASE_APPROVAL_REF=

# Receiving wallets and support are independent, environment-managed identities.
# Supply each receiving number with its registered name. Use full country codes.
# Empty wallets are hidden. Never infer support numbers from a receiving wallet.
GOAL_HINT_MTN_MOMO_NUMBER=
GOAL_HINT_MTN_MOMO_NAME=
GOAL_HINT_AIRTEL_MONEY_NUMBER=
GOAL_HINT_AIRTEL_MONEY_NAME=
GOAL_HINT_CUSTOMER_SUPPORT_NUMBER=
GOAL_HINT_CUSTOMER_SUPPORT_WHATSAPP_NUMBER=
# Optional menu strings, verified on the owner's phone; {amount} becomes the plan price.
GOAL_HINT_MTN_MOMO_MENU_SHORTCUT=
GOAL_HINT_AIRTEL_MONEY_MENU_SHORTCUT=

# First-party analytics (docs/analytics.md). Visitors are counted only after they accept the
# consent banner; GPC/Do Not Track, bots and signed-in administrators are excluded. Needs the
# database capability. Development falls back to admin/admin and a fixed development secret;
# production refuses both, so set a 32+ character random secret and an admin password hash
# from `npm run analytics:hash-password` (never a plain password).
GOAL_HINT_ANALYTICS_ENABLED=true
GOAL_HINT_ANALYTICS_SECRET=
GOAL_HINT_ANALYTICS_ADMIN_USERNAME=
GOAL_HINT_ANALYTICS_ADMIN_PASSWORD_HASH=
# Whole days of raw analytics to keep (default 395); the dashboard setting overrides it.
GOAL_HINT_ANALYTICS_RETENTION_DAYS=
# timezone (default) derives an approximate country/city from the browser time zone without an
# IP lookup; cloudflare or vercel read that edge's visitor-location headers instead.
GOAL_HINT_ANALYTICS_GEO_SOURCE=timezone

# Member administrator numbers. Never set this as a NEXT_PUBLIC_* value.
# Optional private JSON array of canonical phone strings, e.g. ["256700000001"]. Never public.
# These numbers use the shared private password below, receive full access without a subscription,
# and are sent directly to /admin. Public registration and member password resets refuse them.
GOAL_HINT_ADMIN_PHONES=
# Shared administrator password, stored as a scrypt hash (npm run analytics:hash-password).
# Configured phones sign in using this credential and go directly to /admin.
GOAL_HINT_ADMIN_PASSWORD_HASH=
# Optional private password fallback (8–128 characters), used only when the hash is unset.
GOAL_HINT_ADMIN_PASSWORD=

# Source-owned launch requirements; true/other locales fail validation.
GOAL_HINT_ADS_ENABLED=false
GOAL_HINT_DARK_MODE_ENABLED=false
GOAL_HINT_EXACT_SCORES_ENABLED=false
GOAL_HINT_LOCALES=en
