generator client {
  provider               = "prisma-client"
  output                 = "../src/server/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  engineType             = "client"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "mysql"
}

// This stable coordination row serializes every reservation for one provider account.
model ApiQuotaAccount {
  id        String            @id @db.Char(64)
  stateJson Json?
  periods   ApiQuotaPeriod[]
  attempts  ApiQuotaAttempt[]
}

model ApiQuotaPeriod {
  accountId String          @db.Char(64)
  id        String          @db.Char(64)
  stateJson Json
  account   ApiQuotaAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([accountId, id])
}

model ApiQuotaAttempt {
  accountId    String          @db.Char(64)
  id           String          @db.Char(64)
  workKey      String?         @db.Char(64)
  state        String          @db.VarChar(16)
  priority     Int
  queuedAt     DateTime        @db.DateTime(3)
  deadlineAt   DateTime        @db.DateTime(3)
  dispatchedAt DateTime?       @db.DateTime(3)
  periodId     String?         @db.Char(64)
  sequence     Int?
  payloadJson  Json
  account      ApiQuotaAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([accountId, id])
  @@unique([accountId, workKey])
  @@index([accountId, dispatchedAt])
  @@index([accountId, state, priority, queuedAt])
  @@index([accountId, periodId, sequence])
}

// A permanent provider row serializes identity resolution and catalog imports.
model FootballCatalogLock {
  provider String @id @db.VarChar(32)
}

model FootballTeam {
  id                    String                    @id @default(uuid()) @db.Char(36)
  name                  String?                   @db.VarChar(512)
  nameSearch            String?                   @db.VarChar(512)
  code                  String?                   @db.VarChar(64)
  country               String?                   @db.VarChar(256)
  countrySearch         String?                   @db.VarChar(256)
  national              Boolean?
  logoUrl               String?                   @db.VarChar(2048)
  retrievedAt           DateTime                  @db.DateTime(3)
  providerUpdatedAt     DateTime?                 @db.DateTime(3)
  createdAt             DateTime                  @default(now()) @db.DateTime(3)
  updatedAt             DateTime                  @updatedAt @db.DateTime(3)
  providers             FootballTeamProvider[]
  aliases               FootballTeamAlias[]
  homeFixtures          FootballFixture[]         @relation("FootballHomeTeam")
  awayFixtures          FootballFixture[]         @relation("FootballAwayTeam")
  homeEvidenceSources   EvidenceSourceVersion[]   @relation("EvidenceSourceHomeTeam")
  awayEvidenceSources   EvidenceSourceVersion[]   @relation("EvidenceSourceAwayTeam")
  homeEvidenceSnapshots FixtureEvidenceSnapshot[] @relation("EvidenceSnapshotHomeTeam")
  awayEvidenceSnapshots FixtureEvidenceSnapshot[] @relation("EvidenceSnapshotAwayTeam")

  @@index([nameSearch])
  @@index([countrySearch, nameSearch])
}

model FootballTeamProvider {
  provider    String       @db.VarChar(32)
  externalId  BigInt       @db.UnsignedBigInt
  teamId      String       @db.Char(36)
  evidenceRef String?      @db.VarChar(512)
  sourceRef   String?      @db.VarChar(512)
  mappedAt    DateTime     @db.DateTime(3)
  team        FootballTeam @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([provider, externalId])
  @@index([teamId])
}

model FootballTeamAlias {
  teamId           String       @db.Char(36)
  normalizedSearch String       @db.VarChar(512)
  name             String       @db.VarChar(512)
  observedAt       DateTime     @db.DateTime(3)
  sourceRef        String       @db.VarChar(512)
  team             FootballTeam @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([teamId, normalizedSearch])
  @@index([normalizedSearch])
}

model FootballCompetition {
  id                String                        @id @default(uuid()) @db.Char(36)
  name              String?                       @db.VarChar(512)
  nameSearch        String?                       @db.VarChar(512)
  country           String?                       @db.VarChar(256)
  countrySearch     String?                       @db.VarChar(256)
  type              String?                       @db.VarChar(32)
  logoUrl           String?                       @db.VarChar(2048)
  retrievedAt       DateTime                      @db.DateTime(3)
  providerUpdatedAt DateTime?                     @db.DateTime(3)
  createdAt         DateTime                      @default(now()) @db.DateTime(3)
  updatedAt         DateTime                      @updatedAt @db.DateTime(3)
  providers         FootballCompetitionProvider[]
  aliases           FootballCompetitionAlias[]
  seasons           FootballSeason[]

  @@index([nameSearch])
  @@index([countrySearch, nameSearch])
}

model FootballCompetitionProvider {
  provider      String              @db.VarChar(32)
  externalId    BigInt              @db.UnsignedBigInt
  competitionId String              @db.Char(36)
  evidenceRef   String?             @db.VarChar(512)
  sourceRef     String?             @db.VarChar(512)
  mappedAt      DateTime            @db.DateTime(3)
  competition   FootballCompetition @relation(fields: [competitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([provider, externalId])
  @@index([competitionId])
}

model FootballCompetitionAlias {
  competitionId    String              @db.Char(36)
  normalizedSearch String              @db.VarChar(512)
  name             String              @db.VarChar(512)
  observedAt       DateTime            @db.DateTime(3)
  sourceRef        String              @db.VarChar(512)
  competition      FootballCompetition @relation(fields: [competitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([competitionId, normalizedSearch])
  @@index([normalizedSearch])
}

model FootballSeason {
  id                String              @id @default(uuid()) @db.Char(36)
  competitionId     String              @db.Char(36)
  year              Int
  current           Boolean?
  coverage          Json?
  retrievedAt       DateTime            @db.DateTime(3)
  providerUpdatedAt DateTime?           @db.DateTime(3)
  competition       FootballCompetition @relation(fields: [competitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fixtures          FootballFixture[]

  @@unique([competitionId, year])
}

model FootballFixture {
  id                    String                    @id @default(uuid()) @db.Char(36)
  provider              String                    @db.VarChar(32)
  externalId            BigInt                    @db.UnsignedBigInt
  homeTeamId            String                    @db.Char(36)
  awayTeamId            String                    @db.Char(36)
  seasonId              String                    @db.Char(36)
  round                 String?                   @db.VarChar(512)
  kickoff               DateTime?                 @db.DateTime(3)
  eatDate               DateTime?                 @db.Date
  status                String                    @default("unknown") @db.VarChar(32)
  providerStatus        String?                   @db.VarChar(32)
  elapsedMinutes        Int?
  regulationHome        Int?
  regulationAway        Int?
  regulationEvidenceRef String?                   @db.VarChar(512)
  regulationVerifiedAt  DateTime?                 @db.DateTime(3)
  retrievedAt           DateTime                  @db.DateTime(3)
  providerUpdatedAt     DateTime?                 @db.DateTime(3)
  dataVersion           BigInt                    @default(1) @db.UnsignedBigInt
  createdAt             DateTime                  @default(now()) @db.DateTime(3)
  updatedAt             DateTime                  @updatedAt @db.DateTime(3)
  homeTeam              FootballTeam              @relation("FootballHomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  awayTeam              FootballTeam              @relation("FootballAwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  season                FootballSeason            @relation(fields: [seasonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  audits                FootballFixtureAudit[]
  evidenceSources       EvidenceSourceVersion[]
  evidenceSnapshots     FixtureEvidenceSnapshot[]

  @@unique([provider, externalId])
  @@index([eatDate, kickoff])
  @@index([kickoff])
  @@index([status, kickoff])
  @@index([seasonId, kickoff])
  @@index([seasonId, round, kickoff])
  @@index([homeTeamId, kickoff])
  @@index([awayTeamId, kickoff])
}

model FootballFixtureAudit {
  id          String          @id @default(uuid()) @db.Char(36)
  fixtureId   String          @db.Char(36)
  importId    String          @db.Char(36)
  dataVersion BigInt          @db.UnsignedBigInt
  observedAt  DateTime        @db.DateTime(3)
  changes     Json
  fixture     FootballFixture @relation(fields: [fixtureId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  import      FootballImport  @relation(fields: [importId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([fixtureId, dataVersion])
  @@index([importId])
}

model FootballImport {
  id                   String                 @id @default(uuid()) @db.Char(36)
  sequence             BigInt                 @unique @default(autoincrement()) @db.UnsignedBigInt
  fingerprint          String                 @db.Char(64)
  requestFingerprint   String                 @db.Char(64)
  selection            Json
  scopeKey             String                 @db.Char(64)
  provider             String                 @db.VarChar(32)
  kind                 String                 @db.VarChar(32)
  status               String                 @db.VarChar(32)
  observedAt           DateTime               @db.DateTime(3)
  recordedAt           DateTime               @db.DateTime(3)
  receivedCount        Int
  importedCount        Int
  rejectedCount        Int
  requestsDispatched   Int
  reasons              Json
  missingIds           Json
  missingCoverage      Json
  provenance           Json
  retentionEvidenceRef String                 @db.VarChar(512)
  subsetEvidenceRef    String?                @db.VarChar(512)
  fixtureIds           Json
  changedFixtureIds    Json
  fixtureAudits        FootballFixtureAudit[]

  @@index([fingerprint])
  @@index([scopeKey, observedAt, sequence])
}

model FootballIdentityReview {
  id                  String   @id @default(uuid()) @db.Char(36)
  provider            String   @db.VarChar(32)
  externalId          BigInt   @db.UnsignedBigInt
  candidateExternalId BigInt   @db.UnsignedBigInt
  status              String   @default("pending") @db.VarChar(32)
  reason              String   @db.VarChar(32)
  sourceRef           String   @db.VarChar(512)
  evidenceRef         String?  @db.VarChar(512)
  observedAt          DateTime @db.DateTime(3)

  @@unique([provider, externalId, candidateExternalId])
  @@index([status, observedAt])
}

// Each category retains its own permanent account row to serialize ledger mutations.
model CostBudgetAccount {
  accountId String              @db.Char(64)
  category  String              @db.VarChar(16)
  stateJson Json?
  periods   CostBudgetPeriod[]
  jobs      CostBudgetJob[]
  attempts  CostBudgetAttempt[]

  @@id([accountId, category])
}

model CostBudgetPeriod {
  accountId            String              @db.Char(64)
  category             String              @db.VarChar(16)
  id                   String              @db.Char(64)
  startsAt             DateTime            @db.DateTime(3)
  endsAt               DateTime            @db.DateTime(3)
  capAmount            Decimal             @db.Decimal(38, 12)
  openingChargedAmount Decimal             @db.Decimal(38, 12)
  stateJson            Json
  account              CostBudgetAccount   @relation(fields: [accountId, category], references: [accountId, category], onDelete: Restrict, onUpdate: Restrict)
  attempts             CostBudgetAttempt[]

  @@id([accountId, category, id])
  @@index([accountId, category, startsAt, endsAt])
}

model CostBudgetJob {
  accountId  String              @db.Char(64)
  category   String              @db.VarChar(16)
  id         String              @db.Char(64)
  workKey    String              @db.Char(64)
  startsAt   DateTime            @db.DateTime(3)
  deadlineAt DateTime            @db.DateTime(3)
  capAmount  Decimal             @db.Decimal(38, 12)
  stateJson  Json
  account    CostBudgetAccount   @relation(fields: [accountId, category], references: [accountId, category], onDelete: Restrict, onUpdate: Restrict)
  attempts   CostBudgetAttempt[]

  @@id([accountId, category, id])
  @@unique([accountId, category, workKey])
}

model CostBudgetAttempt {
  accountId           String            @db.Char(64)
  category            String            @db.VarChar(16)
  id                  String            @db.Char(64)
  jobId               String            @db.Char(64)
  periodId            String?           @db.Char(64)
  state               String            @db.VarChar(24)
  queuedAt            DateTime          @db.DateTime(3)
  kickoffAt           DateTime?         @db.DateTime(3)
  priority            Int
  deadlineAt          DateTime          @db.DateTime(3)
  dispatchedAt        DateTime?         @db.DateTime(3)
  maxCostAmount       Decimal           @db.Decimal(38, 12)
  liabilityAmount     Decimal           @db.Decimal(38, 12)
  estimatedAmount     Decimal?          @db.Decimal(38, 12)
  observedAmount      Decimal?          @db.Decimal(38, 12)
  invoicedAmount      Decimal?          @db.Decimal(38, 12)
  chargedRequests     BigInt            @default(0) @db.UnsignedBigInt
  chargedInputTokens  BigInt            @default(0) @db.UnsignedBigInt
  chargedOutputTokens BigInt            @default(0) @db.UnsignedBigInt
  chargedBilledUnits  BigInt            @default(0) @db.UnsignedBigInt
  timeMs              BigInt            @default(0) @db.UnsignedBigInt
  overage             Boolean           @default(false)
  provider            String            @db.VarChar(128)
  model               String?           @db.VarChar(128)
  rateVersion         String            @db.VarChar(128)
  integrity           String            @db.Char(64)
  stateJson           Json
  account             CostBudgetAccount @relation(fields: [accountId, category], references: [accountId, category], onDelete: Restrict, onUpdate: Restrict)
  job                 CostBudgetJob     @relation(fields: [accountId, category, jobId], references: [accountId, category, id], onDelete: Restrict, onUpdate: Restrict)
  period              CostBudgetPeriod? @relation(fields: [accountId, category, periodId], references: [accountId, category, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([accountId, category, id])
  @@index([accountId, category, state, priority, kickoffAt, queuedAt])
  @@index([accountId, category, periodId])
  @@index([accountId, category, jobId])
}

// Attributable, content-addressed source versions never replace older evidence.
model EvidenceSourceVersion {
  id                String                          @id @db.Char(64)
  fixtureId         String                          @db.Char(36)
  homeTeamId        String                          @db.Char(36)
  awayTeamId        String                          @db.Char(36)
  fixtureVersion    BigInt                          @db.UnsignedBigInt
  sourceKey         String                          @db.Char(64)
  syndicationKey    String?                         @db.Char(64)
  kind              String                          @db.VarChar(16)
  version           String                          @db.VarChar(128)
  publisher         String                          @db.VarChar(512)
  title             String                          @db.VarChar(2048)
  sourceUrl         String?                         @db.VarChar(2048)
  publishedAt       DateTime?                       @db.DateTime(3)
  retrievedAt       DateTime                        @db.DateTime(3)
  providerUpdatedAt DateTime?                       @db.DateTime(3)
  retainUntil       DateTime                        @db.DateTime(3)
  integrity         String                          @db.Char(64)
  metadataJson      Json
  fixture           FootballFixture                 @relation(fields: [fixtureId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  homeTeam          FootballTeam                    @relation("EvidenceSourceHomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  awayTeam          FootballTeam                    @relation("EvidenceSourceAwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  snapshots         FixtureEvidenceSnapshotSource[]

  @@unique([id, fixtureId, homeTeamId, awayTeamId, fixtureVersion], map: "EvidenceSourceVersion_binding_key")
  @@index([sourceKey, retrievedAt])
  @@index([fixtureId, retrievedAt])
  @@index([retainUntil])
}

// One immutable replay record per caller-supplied collection request. Identical
// snapshot bodies may be associated with separate requests without new sources.
model FixtureEvidenceSnapshot {
  requestId          String                          @id @db.Char(64)
  requestFingerprint String                          @db.Char(64)
  contentHash        String                          @db.Char(64)
  fixtureId          String                          @db.Char(36)
  homeTeamId         String                          @db.Char(36)
  awayTeamId         String                          @db.Char(36)
  fixtureVersion     BigInt                          @db.UnsignedBigInt
  analysisAt         DateTime                        @db.DateTime(3)
  cutoffAt           DateTime                        @db.DateTime(3)
  kickoffAt          DateTime                        @db.DateTime(3)
  cycleId            String?                         @db.Char(36)
  runId              String?                         @db.Char(36)
  policyVersion      String                          @db.VarChar(128)
  sufficient         Boolean
  integrity          String                          @db.Char(64)
  snapshotJson       Json
  fixture            FootballFixture                 @relation(fields: [fixtureId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  homeTeam           FootballTeam                    @relation("EvidenceSnapshotHomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  awayTeam           FootballTeam                    @relation("EvidenceSnapshotAwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sources            FixtureEvidenceSnapshotSource[]

  @@unique([requestId, fixtureId, homeTeamId, awayTeamId, fixtureVersion], map: "FixtureEvidenceSnapshot_binding_key")
  @@index([contentHash])
  @@index([fixtureId, analysisAt])
  @@index([cycleId, runId])
}

// Both composite foreign keys require every source to belong to the snapshot's
// exact canonical fixture, team pair and fixture version.
model FixtureEvidenceSnapshotSource {
  requestId       String                  @db.Char(64)
  sourceVersionId String                  @db.Char(64)
  fixtureId       String                  @db.Char(36)
  homeTeamId      String                  @db.Char(36)
  awayTeamId      String                  @db.Char(36)
  fixtureVersion  BigInt                  @db.UnsignedBigInt
  snapshot        FixtureEvidenceSnapshot @relation(fields: [requestId, fixtureId, homeTeamId, awayTeamId, fixtureVersion], references: [requestId, fixtureId, homeTeamId, awayTeamId, fixtureVersion], onDelete: Restrict, onUpdate: Restrict, map: "FixtureEvidenceSnapshotSource_snapshot_fkey")
  source          EvidenceSourceVersion   @relation(fields: [sourceVersionId, fixtureId, homeTeamId, awayTeamId, fixtureVersion], references: [id, fixtureId, homeTeamId, awayTeamId, fixtureVersion], onDelete: Restrict, onUpdate: Restrict, map: "FixtureEvidenceSnapshotSource_source_fkey")

  @@id([requestId, sourceVersionId])
  @@index([sourceVersionId, fixtureId, homeTeamId, awayTeamId, fixtureVersion], map: "FixtureEvidenceSnapshotSource_source_idx")
  @@index([requestId, fixtureId, homeTeamId, awayTeamId, fixtureVersion], map: "FixtureEvidenceSnapshotSource_snapshot_idx")
}
