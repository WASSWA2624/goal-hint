  terminalReason     String?                   @db.VarChar(32)
  run                DailyRun                  @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cycle              PredictionCycle           @relation(fields: [cycleId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  job                DurableJob?               @relation(fields: [jobId, runId, fixtureId, cycleId], references: [id, refreshRunId, refreshFixtureId, refreshCycleId], onDelete: Restrict, onUpdate: Restrict)
  publicationResults PredictionRefreshResult[]

  @@id([runId, fixtureId, cycleId])
  @@unique([runId, rank])
}

// Append-only orchestration intent, dispatch boundaries and final operational receipt.
model PredictionRefreshIntent {
  jobId     String     @id @db.Char(64)
  integrity String     @db.Char(64)
