  job       DurableJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model PredictionRefreshStage {
  jobId     String     @db.Char(64)
  phase     String     @db.VarChar(16)
  kind      String     @db.VarChar(16)
  integrity String     @db.Char(64)
  body      Json
  job       DurableJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([jobId, phase, kind])
}

model PredictionRefreshOutcome {
  jobId     String     @id @db.Char(64)
  integrity String     @db.Char(64)
  body      Json
  job       DurableJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

// Explicit input from lifecycle 024/operator authority; selection never detects postponement.
model SelectionCycleEligibility {
  id              String          @id @db.Char(64)
  fixtureId       String          @db.Char(36)
  previousCycleId String          @unique @db.Char(36)
  previousVersion Int             @db.UnsignedInt
  kickoffAt       DateTime        @db.DateTime(3)
  state           String          @db.VarChar(16)
  actor           String          @db.VarChar(128)
  evidenceRef     String          @db.VarChar(512)
  recordedAt      DateTime        @db.DateTime(3)
  consumedRunId   String?         @db.Char(36)
  eligibleAfter   DateTime?       @db.DateTime(3)
  cycle           PredictionCycle @relation(fields: [previousCycleId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  run             DailyRun?       @relation(fields: [consumedRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([previousCycleId, fixtureId])
}

model PredictionCycle {
  id                    String                        @id @default(uuid()) @db.Char(36)
  fixtureId             String                        @db.Char(36)
  creationKey           String                        @db.Char(64)
  creationHash          String                        @db.Char(64)
  ordinal               Int                           @db.UnsignedInt
  version               Int                           @default(1) @db.UnsignedInt
  scheduleVersion       Int                           @db.UnsignedInt
  kickoffAt             DateTime                      @db.DateTime(3)
  cutoffAt              DateTime                      @db.DateTime(3)
  openedAt              DateTime                      @db.DateTime(3)
  state                 String                        @default("open") @db.VarChar(16)
  currentSetId          String?                       @db.Char(36)
  lockedSetId           String?                       @db.Char(36)
  closedAt              DateTime?                     @db.DateTime(3)
  lockedAt              DateTime?                     @db.DateTime(3)
  voidedAt              DateTime?                     @db.DateTime(3)
  voidReason            String?                       @db.VarChar(2000)
  fixture               FootballFixture               @relation("FixturePredictionCycles", fields: [fixtureId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activeForFixtures     FootballFixture[]             @relation("FixtureActiveCycle")
  sets                  PredictionSet[]               @relation("CyclePredictionSets")
  currentSet            PredictionSet?                @relation("CycleCurrentSet", fields: [currentSetId, id, fixtureId], references: [id, cycleId, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  lockedSet             PredictionSet?                @relation("CycleLockedSet", fields: [lockedSetId, id, fixtureId], references: [id, cycleId, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  schedules             PredictionSchedule[]
  audits                PredictionAudit[]
  jobs                  DurableJob[]
  selections            RunFixture[]
  selectionEligibility  SelectionCycleEligibility?
  publicationBarrier    PredictionPublicationBarrier?
  operations            PredictionCycleOperation[]
  lifecycleObservations FixtureLifecycleObservation[]
  settlements           MarketSettlement[]
  settlementRevisions   MarketSettlementRevision[]
  extendedMarketSettlements ExtendedMarketSettlement[]
  extendedMarketSettlementRevisions ExtendedMarketSettlementRevision[]

  @@unique([id, fixtureId])
  @@unique([fixtureId, creationKey])
  @@unique([fixtureId, ordinal])
  @@index([state, cutoffAt])
  @@index([currentSetId, id, fixtureId], map: "PredictionCycle_current_idx")
  @@index([lockedSetId, id, fixtureId], map: "PredictionCycle_locked_idx")
}

// Append-only schedule observations, including corrections after closure.
model PredictionSchedule {
  id                 String          @id @default(uuid()) @db.Char(36)
  fixtureId          String          @db.Char(36)
  cycleId            String          @db.Char(36)
  version            Int             @db.UnsignedInt
  kickoffAt          DateTime        @db.DateTime(3)
  cutoffAt           DateTime        @db.DateTime(3)
  observedAt         DateTime        @db.DateTime(3)
  providerObservedAt DateTime?       @db.DateTime(3)
  actualStartedAt    DateTime?       @db.DateTime(3)
  actor              String          @db.VarChar(128)
  reason             String          @db.VarChar(2000)
  evidenceRef        String          @db.VarChar(512)
  cycle              PredictionCycle @relation(fields: [cycleId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  sets               PredictionSet[]

  @@unique([cycleId, version])
  @@index([fixtureId, observedAt])
}

// A complete accepted snapshot; no application UPDATE/DELETE grants.
model PredictionSet {
  publishedSlipLegs     PublishedSlipLeg[]
  id                    String                     @id @default(uuid()) @db.Char(36)
  fixtureId             String                     @db.Char(36)
  fixtureVersion        BigInt                     @db.UnsignedBigInt
  cycleId               String                     @db.Char(36)
  runId                 String                     @db.Char(36)
  runSequence           BigInt                     @db.UnsignedBigInt
  jobId                 String                     @db.Char(64)
  fixtureRevision       Int                        @db.UnsignedInt
  cycleRevision         Int                        @db.UnsignedInt
  predecessorId         String?                    @db.Char(36)
  scheduleVersion       Int                        @db.UnsignedInt
  modelVersionId        String?                    @db.Char(64)
  evidenceSnapshotId    String                     @db.Char(64)
  evidenceHash          String                     @db.Char(64)
  evidenceCutoffAt      DateTime                   @db.DateTime(3)
  generationCompletedAt DateTime                   @db.DateTime(3)
  publishedAt           DateTime                   @db.DateTime(3)
  recordedAt            DateTime                   @db.DateTime(3)
  ruleVersion           String                     @db.VarChar(64)
  requestHash           String                     @db.Char(64)
  integrity             String                     @db.Char(64)
  candidateJson         Json
  fixture               FootballFixture            @relation(fields: [fixtureId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cycle                 PredictionCycle            @relation("CyclePredictionSets", fields: [cycleId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  run                   DailyRun                   @relation(fields: [runId, runSequence], references: [id, sequence], onDelete: Restrict, onUpdate: Restrict)
  schedule              PredictionSchedule         @relation(fields: [cycleId, scheduleVersion], references: [cycleId, version], onDelete: Restrict, onUpdate: Restrict)
  evidence              FixtureEvidenceSnapshot    @relation(fields: [evidenceSnapshotId, fixtureId, cycleId, runId, fixtureVersion, evidenceHash], references: [requestId, fixtureId, cycleId, runId, fixtureVersion, contentHash], onDelete: Restrict, onUpdate: Restrict, map: "PredictionSet_evidence_fkey")
  model                 ModelVersion?              @relation(fields: [modelVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  predecessor           PredictionSet?             @relation("PredictionPredecessor", fields: [predecessorId, cycleId, fixtureId], references: [id, cycleId, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  successors            PredictionSet[]            @relation("PredictionPredecessor")
  currentForCycles      PredictionCycle[]          @relation("CycleCurrentSet")
  lockedForCycles       PredictionCycle[]          @relation("CycleLockedSet")
  markets               MarketPrediction[]
  refreshResults        PredictionRefreshResult[]
  cycleOperations       PredictionCycleOperation[]
  settlements           MarketSettlementRevision[]
  goalMarketExtension   GoalMarketExtension?
  impliedMarketExtension ImpliedMarketExtension?
  extendedMarketPublishedPicks ExtendedMarketPublishedPick[]
  extendedMarketSettlements ExtendedMarketSettlementRevision[]

  @@unique([id, cycleId, fixtureId])
  @@unique([runId, fixtureId, cycleId], map: "PredictionSet_refresh_key")
  @@unique([fixtureId, fixtureRevision])
  @@unique([cycleId, cycleRevision])
  @@index([cycleId, runSequence])
  @@index([fixtureId, runSequence, fixtureRevision])
  @@index([predecessorId, cycleId, fixtureId], map: "PredictionSet_predecessor_idx")
  @@index([publishedAt])
}

// Four explicit family rows, including unavailable families. DOUBLE preserves
// the shared domain's binary64 values; canonical JSON retains full provenance.
model MarketPrediction {
  setId               String        @db.Char(36)
  family              String        @db.VarChar(32)
  available           Boolean
  source              String?       @db.VarChar(16)
  selection           String?       @db.VarChar(32)
  selectedProbability Float?        @db.Double
  probability1        Float?        @db.Double
  probability2        Float?        @db.Double
  probability3        Float?        @db.Double
  unavailableReason   String?       @db.VarChar(32)
  generatedAt         DateTime?     @db.DateTime(3)
  retrievedAt         DateTime?     @db.DateTime(3)
  providerUpdatedAt   DateTime?     @db.DateTime(3)
  integrity           String        @db.Char(64)
  payloadJson         Json
  set                 PredictionSet @relation(fields: [setId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([setId, family])
  @@index([family, source])
}

// Additive immutable sibling: legacy candidateJson/four-family rows keep their original bytes.
model GoalMarketExtension {
  revisionId String @id @db.Char(36)
  cycleId String @db.Char(36)
  fixtureId String @db.Char(36)
  ruleVersion String @db.VarChar(64)
  contentHash String @db.Char(64)
  integrity String @db.Char(64)
  recordedAt DateTime @db.DateTime(3)
  body Json
  revision PredictionSet @relation(fields: [revisionId, cycleId, fixtureId], references: [id, cycleId, fixtureId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([revisionId, cycleId, fixtureId], map: "GoalMarketExtension_identity_key")
  @@index([fixtureId, cycleId])
}

// Separate provenance: normalized bookmaker evidence never becomes an AI score distribution.
model ImpliedMarketExtension {
  revisionId String @id @db.Char(36)
  cycleId String @db.Char(36)
  fixtureId String @db.Char(36)
  ruleVersion String @db.VarChar(64)
  contentHash String @db.Char(64)
  integrity String @db.Char(64)
  recordedAt DateTime @db.DateTime(3)
  body Json
  revision PredictionSet @relation(fields: [revisionId, cycleId, fixtureId], references: [id, cycleId, fixtureId], onDelete: Restrict, onUpdate: Restrict, map: "ImpliedMarketExtension_prediction_fkey")

  @@unique([revisionId, cycleId, fixtureId], map: "ImpliedMarketExtension_identity_key")
  @@index([fixtureId, cycleId])
}

// Result-time facts have their own immutable evidence stream; forecast-time averages are never settlement inputs.
model ImpliedMarketResultEvidence {
  id String @id @db.Char(64)
  fixtureId String @db.Char(36)
  resultId String @db.Char(64)
  sequence BigInt @unique @default(autoincrement()) @db.UnsignedBigInt
  recordedAt DateTime @db.DateTime(3)
  contentHash String @db.Char(64)
  integrity String @db.Char(64)
  body Json
  result FixtureResult @relation(fields: [resultId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)

  @@index([fixtureId, resultId, sequence], map: "ImpliedMarketResultEvidence_result_idx")
}

// Bounded materialized picks keep public cards from fetching full distributions or bookmaker catalogues.
model ExtendedMarketPublishedPick {
  revisionId String @db.Char(36)
  cycleId String @db.Char(36)
  fixtureId String @db.Char(36)
  marketKey String @db.VarChar(128)
  source String @db.VarChar(32)
  ruleVersion String @db.VarChar(64)
  period String @db.VarChar(16)
  selection String @db.VarChar(64)
  selectedProbability Float @db.Double
  sortOrder Int @db.UnsignedInt
  integrity String @db.Char(64)
  body Json
  revision PredictionSet @relation(fields: [revisionId, cycleId, fixtureId], references: [id, cycleId, fixtureId], onDelete: Restrict, onUpdate: Restrict)

  @@id([revisionId, marketKey])
  @@index([revisionId, selectedProbability, sortOrder], map: "ExtendedMarketPublishedPick_probability_idx")
}

// Current pointer only. Exact picks, prior result evidence and corrections are immutable siblings.
model ExtendedMarketSettlement {
  fixtureId String @db.Char(36)
  cycleId String @db.Char(36)
  marketKey String @db.VarChar(128)
  revisionId String @unique @db.Char(64)
  cycle PredictionCycle @relation(fields: [cycleId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  revision ExtendedMarketSettlementRevision @relation("ActiveExtendedMarketSettlement", fields: [revisionId, cycleId, marketKey], references: [id, cycleId, marketKey], onDelete: Restrict, onUpdate: Restrict, map: "ExtendedMarketSettlement_revision_fkey")

  @@id([cycleId, marketKey])
  @@unique([revisionId, cycleId, marketKey], map: "ExtendedMarketSettlement_active_key")
  @@index([fixtureId, cycleId])
}

model ExtendedMarketSettlementRevision {
  id String @id @db.Char(64)
  fixtureId String @db.Char(36)
  cycleId String @db.Char(36)
  marketKey String @db.VarChar(128)
  predictionRevisionId String @db.Char(36)
  source String @db.VarChar(32)
  batchId String @db.Char(64)
  previousId String? @unique @db.Char(64)
  resultId String? @db.Char(64)
  inputHash String @db.Char(64)
  at DateTime @db.DateTime(3)
  integrity String @db.Char(64)
  body Json
  cycle PredictionCycle @relation(fields: [cycleId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  prediction PredictionSet @relation(fields: [predictionRevisionId, cycleId, fixtureId], references: [id, cycleId, fixtureId], onDelete: Restrict, onUpdate: Restrict, map: "ExtendedMarketSettlementRevision_prediction_fkey")
  batch SettlementBatch @relation(fields: [batchId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  result FixtureResult? @relation(fields: [resultId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  active ExtendedMarketSettlement? @relation("ActiveExtendedMarketSettlement")
  previous ExtendedMarketSettlementRevision? @relation("ExtendedMarketSettlementHistory", fields: [previousId, cycleId, marketKey], references: [id, cycleId, marketKey], onDelete: Restrict, onUpdate: Restrict, map: "ExtendedMarketSettlementRevision_previous_fkey")
  next ExtendedMarketSettlementRevision? @relation("ExtendedMarketSettlementHistory")

  @@unique([id, cycleId, marketKey], map: "ExtendedMarketSettlementRevision_identity_key")
  @@unique([previousId, cycleId, marketKey], map: "ExtendedMarketSettlementRevision_previous_key")
  @@index([cycleId, marketKey, at, id], map: "ExtendedMarketSettlementRevision_history_idx")
}

model PredictionAudit {
  id          String          @id @default(uuid()) @db.Char(36)
  fixtureId   String          @db.Char(36)
  cycleId     String          @db.Char(36)
  version     Int             @db.UnsignedInt
  eventKey    String          @db.Char(64)
  requestHash String          @db.Char(64)
  kind        String          @db.VarChar(32)
  recordedAt  DateTime        @db.DateTime(3)
  actor       String          @db.VarChar(128)
  reason      String          @db.VarChar(2000)
  evidenceRef String          @db.VarChar(512)
  beforeJson  Json?
  afterJson   Json
  integrity   String          @db.Char(64)
  cycle       PredictionCycle @relation(fields: [cycleId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([cycleId, version])
  @@unique([cycleId, eventKey])
  @@index([fixtureId, recordedAt])
}

// The database row is also the durable delivery record: no external dispatch
// is necessary after commit. Refresh identity never changes between attempts.
model DurableJobEnqueueLock {
  id Int @id @db.UnsignedTinyInt
}

// Append-only recovery intent/outcome. The durable job supplies fencing and resumption.
model RecoveryAudit {
  id        String   @id @db.Char(64)
  jobId     String   @db.Char(64)
  actionId  String   @db.Char(64)
  phase     String   @db.VarChar(16)
  at        DateTime @db.DateTime(3)
  integrity String   @db.Char(64)
  body      Json
  job       DurableJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([jobId, actionId, phase])
  @@index([jobId, at])
  @@index([at])
}

model DurableJob {
  id                 String                    @id @db.Char(64)
  type               String                    @db.VarChar(64)
  handlerVersion     Int                       @db.UnsignedInt
  idempotencyKey     String                    @db.Char(64)
  requestHash        String                    @db.Char(64)
  integrity          String                    @db.Char(64)
  envelopeJson       Json
  refreshRunId       String?                   @db.Char(36)
  refreshFixtureId   String?                   @db.Char(36)
  refreshCycleId     String?                   @db.Char(36)
  state              String                    @default("pending") @db.VarChar(16)
  version            Int                       @default(1) @db.UnsignedInt
  priority           Int                       @db.UnsignedInt
  availableAt        DateTime                  @db.DateTime(3)
  expiresAt          DateTime                  @db.DateTime(3)
  createdAt          DateTime                  @db.DateTime(3)
  updatedAt          DateTime                  @db.DateTime(3)
  attemptCount       Int                       @default(0) @db.UnsignedInt
  fence              Int                       @default(0) @db.UnsignedInt
  ownerId            String?                   @db.Char(64)
  leaseExpiresAt     DateTime?                 @db.DateTime(3)
  attemptDeadlineAt  DateTime?                 @db.DateTime(3)
  finishedAt         DateTime?                 @db.DateTime(3)
  terminalReason     String?                   @db.VarChar(32)
  run                DailyRun?                 @relation(fields: [refreshRunId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cycle              PredictionCycle?          @relation(fields: [refreshCycleId, refreshFixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  attempts           DurableJobAttempt[]
  events             DurableJobEvent[]
  usage              DurableJobUsage[]
  selections         RunFixture[]
  publicationResults PredictionRefreshResult[]
  refreshIntent      PredictionRefreshIntent?
  refreshStages      PredictionRefreshStage[]
  refreshOutcome     PredictionRefreshOutcome?
  recoveryAudits     RecoveryAudit[]

  @@unique([type, handlerVersion, idempotencyKey])
  @@unique([id, refreshRunId, refreshFixtureId, refreshCycleId], map: "DurableJob_selection_key")
  @@unique([refreshRunId, refreshFixtureId, refreshCycleId], map: "DurableJob_refresh_key")
  @@index([type, handlerVersion, state, availableAt, priority])
  @@index([type, handlerVersion, state, leaseExpiresAt])
  @@index([state, leaseExpiresAt, id])
  @@index([state, availableAt, id])
  @@index([updatedAt])
  @@index([finishedAt])
}

// Append-only refresh decisions, separate from immutable accepted forecasts.
model PredictionRefreshResult {
  id             String                 @id @db.Char(64)
  requestHash    String                 @db.Char(64)
  attemptKey     String                 @db.Char(64)
  runId          String                 @db.Char(36)
  runSequence    BigInt                 @db.UnsignedBigInt
  fixtureId      String                 @db.Char(36)
  cycleId        String                 @db.Char(36)
  jobId          String                 @db.Char(64)
  fixtureVersion BigInt                 @db.UnsignedBigInt
  outcome        String                 @db.VarChar(32)
  reason         String                 @db.VarChar(32)
  revisionId     String?                @db.Char(36)
  at             DateTime               @db.DateTime(3)
  integrity      String                 @db.Char(64)
  resultJson     Json
  selection      RunFixture             @relation(fields: [runId, fixtureId, cycleId], references: [runId, fixtureId, cycleId], onDelete: Restrict, onUpdate: Restrict)
  job            DurableJob             @relation(fields: [jobId, runId, fixtureId, cycleId], references: [id, refreshRunId, refreshFixtureId, refreshCycleId], onDelete: Restrict, onUpdate: Restrict, map: "PredictionRefreshResult_job_fkey")
  revision       PredictionSet?         @relation(fields: [revisionId, cycleId, fixtureId], references: [id, cycleId, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  change         PredictionChangeEvent?

  @@unique([runId, fixtureId, cycleId, attemptKey], map: "PredictionRefreshResult_attempt_key")
  @@unique([id, fixtureId, fixtureVersion], map: "PredictionRefreshResult_change_key")
  @@index([fixtureId, cycleId, runSequence, fixtureVersion], map: "PredictionRefreshResult_latest_idx")
  @@index([at])
}

// Safety latch only; 023 owns final closure/locking and 024 owns schedule changes.
model PredictionPublicationBarrier {
  cycleId         String          @id @db.Char(36)
  fixtureId       String          @db.Char(36)
  closedAt        DateTime        @db.DateTime(3)
  recordedAt      DateTime        @db.DateTime(3)
  integrity       String          @db.Char(64)
  observationJson Json
  cycle           PredictionCycle @relation(fields: [cycleId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([cycleId, fixtureId])
}

// Per-fixture data-version cursor. Delivery/acknowledgement belongs to future caching.
model PredictionChangeEvent {
  fixtureId         String                       @db.Char(36)
  version           BigInt                       @db.UnsignedBigInt
  resultId          String?                      @unique @db.Char(64)
  operationId       String?                      @unique @db.Char(64)
  lifecycleId       String?                      @unique @db.Char(64)
  fixtureResultId   String?                      @unique @db.Char(64)
  settlementId      String?                      @unique @db.Char(64)
  settlement        SettlementBatch?             @relation(fields: [settlementId, fixtureId, version], references: [id, fixtureId, fixtureVersion], onDelete: Restrict, onUpdate: Restrict)
  settlementReceipt SettlementEventReceipt?
  fixtureResult     FixtureResult?               @relation(fields: [fixtureResultId, fixtureId, version], references: [id, fixtureId, fixtureVersion], onDelete: Restrict, onUpdate: Restrict)
  kind              String                       @db.VarChar(32)
  at                DateTime                     @db.DateTime(3)
  result            PredictionRefreshResult?     @relation(fields: [resultId, fixtureId, version], references: [id, fixtureId, fixtureVersion], onDelete: Restrict, onUpdate: Restrict)
  operation         PredictionCycleOperation?    @relation(fields: [operationId, fixtureId, version], references: [id, fixtureId, fixtureVersion], onDelete: Restrict, onUpdate: Restrict)
  lifecycle         FixtureLifecycleObservation? @relation(fields: [lifecycleId, fixtureId, version], references: [id, fixtureId, fixtureVersion], onDelete: Restrict, onUpdate: Restrict)

  @@id([fixtureId, version])
  @@unique([resultId, fixtureId, version], map: "PredictionChangeEvent_result_key")
  @@unique([operationId, fixtureId, version], map: "PredictionChangeEvent_operation_key")
  @@unique([lifecycleId, fixtureId, version], map: "PredictionChangeEvent_lifecycle_key")
  @@unique([fixtureResultId, fixtureId, version], map: "PredictionChangeEvent_fixture_result_key")
  @@unique([settlementId, fixtureId, version], map: "PredictionChangeEvent_settlement_key")
}

// One continuous poller per provider account, independent of visitors and job delivery.
model ResultPollerLease {
  accountId    String          @id @db.Char(64)
  ownerId      String?         @db.Char(64)
  fence        BigInt          @default(0) @db.UnsignedBigInt
  leaseUntil   DateTime        @db.DateTime(3)
  nextLiveAt   DateTime        @db.DateTime(3)
  nextDateAt   DateTime        @db.DateTime(3)
  liveFailures Int             @default(0) @db.UnsignedInt
  dateFailures Int             @default(0) @db.UnsignedInt
  liveError    String?         @db.VarChar(128)
  dateError    String?         @db.VarChar(128)
  account      ApiQuotaAccount @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

// Commit original normalized responses before applying any fixture. Only completedAt is mutable.
model ResultSyncBatch {
  id           String                      @id @db.Char(64)
  accountId    String                      @db.Char(64)
  receivedAt   DateTime                    @db.DateTime(3)
  completedAt  DateTime?                   @db.DateTime(3)
  integrity    String                      @db.Char(64)
  body         Json
  account      ApiQuotaAccount             @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  observations ResultProviderObservation[]

  @@index([accountId, completedAt, receivedAt])
}

// Retrieval attempts/age are projections; result revisions and observations stay append-only.
model FixtureResultState {
  fixtureId      String          @id @db.Char(36)
  resultId       String?         @db.Char(64)
  firstTrackedAt DateTime        @db.DateTime(3)
  firstFinalAt   DateTime?       @db.DateTime(3)
  lastSyncAt     DateTime?       @db.DateTime(3)
  lastAttemptAt  DateTime?       @db.DateTime(3)
  nextCheckAt    DateTime?       @db.DateTime(3)
  failures       Int             @default(0) @db.UnsignedInt
  delayReason    String?         @db.VarChar(128)
  fixture        FootballFixture @relation(fields: [fixtureId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  result         FixtureResult?  @relation(fields: [resultId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)

  @@index([nextCheckAt, fixtureId])
}

model FixtureResult {
  id                 String                     @id @db.Char(64)
  fixtureId          String                     @db.Char(36)
  fixtureVersion     BigInt                     @db.UnsignedBigInt
  observedAt         DateTime                   @db.DateTime(3)
  status             String                     @db.VarChar(32)
  regulationVerified Boolean
  regulationHome     Int?                       @db.UnsignedInt
  regulationAway     Int?                       @db.UnsignedInt
  contentHash        String                     @db.Char(64)
  integrity          String                     @db.Char(64)
  body               Json
  fixture            FootballFixture            @relation(fields: [fixtureId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  states             FixtureResultState[]
  event              PredictionChangeEvent?
  settlements        MarketSettlementRevision[]
  extendedMarketSettlements ExtendedMarketSettlementRevision[]
  impliedMarketEvidence ImpliedMarketResultEvidence[]

  @@unique([id, fixtureId])
  @@unique([id, fixtureId, fixtureVersion], map: "FixtureResult_change_key")
  @@index([fixtureId, observedAt, id])
}

// One atomic projection change and invalidation per fixture, regardless of family count.
model SettlementBatch {
  id             String                     @id @db.Char(64)
  fixtureId      String                     @db.Char(36)
  fixtureVersion BigInt                     @db.UnsignedBigInt
  at             DateTime                   @db.DateTime(3)
  fixture        FootballFixture            @relation(fields: [fixtureId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions      MarketSettlementRevision[]
  extendedMarketRevisions ExtendedMarketSettlementRevision[]
  event          PredictionChangeEvent?

  @@unique([id, fixtureId])
  @@unique([id, fixtureId, fixtureVersion], map: "SettlementBatch_change_key")
}

// Mutable pointer only; history and prior correction evidence are never overwritten.
model MarketSettlement {
  fixtureId  String                   @db.Char(36)
  cycleId    String                   @db.Char(36)
  family     String                   @db.VarChar(32)
  revisionId String                   @unique @db.Char(64)
  cycle      PredictionCycle          @relation(fields: [cycleId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  revision   MarketSettlementRevision @relation("ActiveSettlement", fields: [revisionId, cycleId, family], references: [id, cycleId, family], onDelete: Restrict, onUpdate: Restrict)

  @@id([cycleId, family])
  @@unique([revisionId, cycleId, family], map: "MarketSettlement_active_key")
  @@index([fixtureId, cycleId])
}

model MarketSettlementRevision {
  id          String                    @id @db.Char(64)
  fixtureId   String                    @db.Char(36)
  cycleId     String                    @db.Char(36)
  family      String                    @db.VarChar(32)
  batchId     String                    @db.Char(64)
  previousId  String?                   @unique @db.Char(64)
  resultId    String?                   @db.Char(64)
  lockedSetId String?                   @db.Char(36)
  inputHash   String                    @db.Char(64)
  at          DateTime                  @db.DateTime(3)
  integrity   String                    @db.Char(64)
  body        Json
  cycle       PredictionCycle           @relation(fields: [cycleId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  batch       SettlementBatch           @relation(fields: [batchId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  result      FixtureResult?            @relation(fields: [resultId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  lockedSet   PredictionSet?            @relation(fields: [lockedSetId, cycleId, fixtureId], references: [id, cycleId, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  active      MarketSettlement?         @relation("ActiveSettlement")
  previous    MarketSettlementRevision? @relation("SettlementHistory", fields: [previousId, cycleId, family], references: [id, cycleId, family], onDelete: Restrict, onUpdate: Restrict)
  next        MarketSettlementRevision? @relation("SettlementHistory")

  @@unique([id, cycleId, family], map: "MarketSettlementRevision_identity_key")
  @@unique([previousId, cycleId, family], map: "MarketSettlementRevision_previous_key")
  @@index([cycleId, family, at, id])
}

// Per-event receipts avoid losing late commits behind a global time watermark.
model SettlementEventReceipt {
  fixtureId String                @db.Char(36)
  version   BigInt                @db.UnsignedBigInt
  at        DateTime              @db.DateTime(3)
  event     PredictionChangeEvent @relation(fields: [fixtureId, version], references: [fixtureId, version], onDelete: Restrict, onUpdate: Restrict)

  @@id([fixtureId, version])
}

model ResultProviderObservation {
  id          String                      @id @db.Char(64)
  batchId     String                      @db.Char(64)
  fixtureId   String                      @db.Char(36)
  lifecycleId String                      @db.Char(64)
  retrievedAt DateTime                    @db.DateTime(3)
  integrity   String                      @db.Char(64)
  body        Json
  fixture     FootballFixture             @relation(fields: [fixtureId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  batch       ResultSyncBatch             @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lifecycle   FixtureLifecycleObservation @relation(fields: [lifecycleId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([batchId, fixtureId])
  @@index([fixtureId, retrievedAt, id])
}

// Mutable eligibility/cursor projection, rebuilt from append-only observations.
model FixtureLifecycleState {
  fixtureId         String          @id @db.Char(36)
  retrievedAt       DateTime        @db.DateTime(3)
  providerUpdatedAt DateTime?       @db.DateTime(3)
  contentHash       String?         @db.Char(64)
  actualStartedAt   DateTime?       @db.DateTime(3)
  issue             String?         @db.VarChar(128)
  fixture           FootballFixture @relation(fields: [fixtureId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

// Attributable normalized schedule/status/result evidence, never raw payloads.
model FixtureLifecycleObservation {
  id                 String                      @id @db.Char(64)
  fixtureId          String                      @db.Char(36)
  cycleId            String?                     @db.Char(36)
  fixtureVersion     BigInt                      @db.UnsignedBigInt
  at                 DateTime                    @db.DateTime(3)
  retrievedAt        DateTime                    @db.DateTime(3)
  outcome            String                      @db.VarChar(16)
  reason             String                      @db.VarChar(128)
  integrity          String                      @db.Char(64)
  receiptJson        Json
  fixture            FootballFixture             @relation(fields: [fixtureId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cycle              PredictionCycle?            @relation(fields: [cycleId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  event              PredictionChangeEvent?
  resultObservations ResultProviderObservation[]

  @@unique([id, fixtureId], map: "FixtureLifecycleObservation_result_key")
  @@unique([id, fixtureId, fixtureVersion], map: "FixtureLifecycleObservation_change_key")
  @@index([fixtureId, at, id])
}

// Immutable closure/void receipts remain separate from refresh and forecast payloads.
model PredictionCycleOperation {
  id             String                 @id @db.Char(64)
  fixtureId      String                 @db.Char(36)
  cycleId        String                 @db.Char(36)
  kind           String                 @db.VarChar(16)
  fixtureVersion BigInt                 @db.UnsignedBigInt
  revisionId     String?                @db.Char(36)
  at             DateTime               @db.DateTime(3)
  integrity      String                 @db.Char(64)
  operationJson  Json
  cycle          PredictionCycle        @relation(fields: [cycleId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  revision       PredictionSet?         @relation(fields: [revisionId, cycleId, fixtureId], references: [id, cycleId, fixtureId], onDelete: Restrict, onUpdate: Restrict)
  event          PredictionChangeEvent?

  @@unique([cycleId, kind])
  @@unique([id, fixtureId, fixtureVersion], map: "PredictionCycleOperation_change_key")
}

model DurableJobAttempt {
  id         String            @id @db.Char(64)
  jobId      String            @db.Char(64)
  number     Int               @db.UnsignedInt
  fence      Int               @db.UnsignedInt
  ownerId    String            @db.Char(64)
  startedAt  DateTime          @db.DateTime(3)
  deadlineAt DateTime          @db.DateTime(3)
  finishedAt DateTime?         @db.DateTime(3)
  outcome    String            @db.VarChar(16)
  reason     String?           @db.VarChar(32)
  job        DurableJob        @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  events     DurableJobEvent[]
  usage      DurableJobUsage[]

  @@unique([jobId, number])
  @@unique([id, jobId])
  @@index([finishedAt])
}

model DurableJobEvent {
  id        String             @id @default(uuid()) @db.Char(36)
  jobId     String             @db.Char(64)
  version   Int                @db.UnsignedInt
  attemptId String?            @db.Char(64)
  kind      String             @db.VarChar(32)
  reason    String?            @db.VarChar(32)
  at        DateTime           @db.DateTime(3)
  job       DurableJob         @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attempt   DurableJobAttempt? @relation(fields: [attemptId, jobId], references: [id, jobId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([jobId, version])
}

// Disposable shared public JSON. Generations are advanced by source-table triggers
// in the same transaction as the underlying change, before any consumer runs.
model PublicCacheTag {
  tag        String @id @db.VarChar(64)
  generation BigInt @db.UnsignedBigInt
}

model PublicResponseCache {
  key         String   @id @db.Char(64)
  generations Json
  body        Json
  createdAt   DateTime @db.DateTime(3)
  expiresAt   DateTime @db.DateTime(3)

  @@index([expiresAt, key])
}

// No timestamp watermark: late commits and downtime remain discoverable.
model PublicCacheInvalidation {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tag            String    @db.VarChar(64)
  generation     BigInt    @db.UnsignedBigInt
  at             DateTime  @db.DateTime(3)
  acknowledgedAt DateTime? @db.DateTime(3)

  @@index([acknowledgedAt, id])
}

// Append-only links to the existing quota/cost ledgers; no secret/raw response.
model DurableJobUsage {
  id               String            @id @db.Char(64)
  jobId            String            @db.Char(64)
  attemptId        String            @db.Char(64)
  version          Int               @db.UnsignedInt
  requestHash      String            @db.Char(64)
  provider         String            @db.VarChar(16)
  requestReference String            @db.Char(64)
  costReference    String?           @db.Char(64)
  phase            String            @db.VarChar(16)
  requests         Int               @db.UnsignedInt
  durationMs       Int?              @db.UnsignedInt
  recordedAt       DateTime          @db.DateTime(3)
  job              DurableJob        @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attempt          DurableJobAttempt @relation(fields: [attemptId, jobId], references: [id, jobId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([jobId, version])
}

// Prompt 052 provider odds. Raw provider payloads are never stored; prices live only in
// normalized snapshots. The application role never deletes odds rows.
// Append-only import receipt: INSERT/SELECT only. Page provenance without quota feedback; no prices.
model OddsImportBatch {
  id                 String                 @id @db.Char(64)
  accountId          String                 @db.Char(64)
  kind               String                 @db.VarChar(16)
  scopeKey           String                 @db.VarChar(96)
  policyHash         String                 @db.Char(64)
  status             String                 @db.VarChar(16)
  requestsDispatched Int                    @db.UnsignedInt
  receivedAt         DateTime               @db.DateTime(3)
  integrity          String                 @db.Char(64)
  body               Json
  account            ApiQuotaAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  betObservations    OddsBetObservation[]
  snapshots          ProviderOddsSnapshot[]
  fixtureStates      FixtureOddsState[]

  @@index([accountId, receivedAt])
  @@index([scopeKey, receivedAt])
}

// Every /odds/bets name ever observed (053/054 mapping input): INSERT/SELECT only, insert-if-absent.
model OddsBetObservation {
  id            String          @id @db.Char(64)
  provider      String          @db.VarChar(32)
  betExternalId Int             @db.UnsignedInt
  name          String          @db.VarChar(256)
  batchId       String          @db.Char(64)
  firstSeenAt   DateTime        @db.DateTime(3)
  batch         OddsImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, betExternalId, name])
  @@index([batchId])
}

// Append-only, content-chained prices per fixture x bookmaker x bet: INSERT/SELECT only.
// A row is written only when the canonical values differ from the latest row for that key.
model ProviderOddsSnapshot {
  id                  String                @id @db.Char(64)
  fixtureId           String                @db.Char(36)
  batchId             String                @db.Char(64)
  previousId          String?               @unique @db.Char(64)
  bookmakerExternalId Int                   @db.UnsignedInt
  bookmakerName       String?               @db.VarChar(128)
  betExternalId       Int                   @db.UnsignedInt
  betName             String?               @db.VarChar(256)
  valuesHash          String                @db.Char(64)
  selectionCount      Int                   @db.UnsignedSmallInt
  retrievedAt         DateTime              @db.DateTime(3)
  providerUpdatedAt   DateTime?             @db.DateTime(3)
  retainUntil         DateTime              @db.DateTime(3)
  integrity           String                @db.Char(64)
  body                Json
  fixture             FootballFixture       @relation(fields: [fixtureId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  batch               OddsImportBatch       @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  previous            ProviderOddsSnapshot? @relation("ProviderOddsSnapshotChain", fields: [previousId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  next                ProviderOddsSnapshot? @relation("ProviderOddsSnapshotChain")
  prices              FixtureOddsPrice[]

  @@unique([id, fixtureId])
  @@index([fixtureId, bookmakerExternalId, betExternalId, retrievedAt])
  @@index([batchId])
  @@index([retainUntil])
}

// Mutable per-fixture odds state and mutex: INSERT/SELECT plus
// UPDATE(latestBatchId, policyHash, lastRetrievedAt, lastProviderUpdatedAt, withdrawnAt, publicVersion).
model FixtureOddsState {
  fixtureId             String          @id @db.Char(36)
  latestBatchId         String          @db.Char(64)
  policyHash            String          @db.Char(64)
  lastRetrievedAt       DateTime        @db.DateTime(3)
  lastProviderUpdatedAt DateTime?       @db.DateTime(3)
  withdrawnAt           DateTime?       @db.DateTime(3)
  publicVersion         Int             @default(0) @db.UnsignedInt
  fixture               FootballFixture @relation(fields: [fixtureId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  latestBatch           OddsImportBatch @relation(fields: [latestBatchId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([latestBatchId])
}

// Mutable public projection read by feed and detail; one row per (fixture, market, selection), so the
// feed join is 1:1. Written only under verified odds display rights. INSERT/SELECT plus non-key UPDATE.
model FixtureOddsPrice {
  fixtureId           String                @db.Char(36)
  marketKey           String                @db.VarChar(96)
  selection           String                @db.VarChar(64)
  basis               String                @db.VarChar(16)
  bookmakerExternalId Int?                  @db.UnsignedInt
  line                Decimal?              @db.Decimal(6, 2)
  priceDecimal        Decimal               @db.Decimal(10, 4)
  displayHundredths   Int                   @db.UnsignedInt
  impliedProbability  Decimal               @db.Decimal(13, 12)
  overround           Decimal               @db.Decimal(13, 12)
  method              String                @db.VarChar(32)
  mappingVersion      String                @db.VarChar(32)
  snapshotId          String?               @db.Char(64)
  basisJson           Json?
  retrievedAt         DateTime              @db.DateTime(3)
  providerUpdatedAt   DateTime?             @db.DateTime(3)
  stale               Boolean
  fixture             FootballFixture       @relation(fields: [fixtureId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  snapshot            ProviderOddsSnapshot? @relation(fields: [snapshotId, fixtureId], references: [id, fixtureId], onDelete: Restrict, onUpdate: Restrict, map: "FixtureOddsPrice_snapshot_fkey")

  @@id([fixtureId, marketKey, selection])
  @@index([snapshotId, fixtureId])
}

// Consent-gated first-party analytics (docs/analytics.md). Visitor keys are HMACs of a random browser value;
// no IP address, raw user agent, query string or form input is stored. Rows expire by the retention setting.
model AnalyticsVisitor {
  id           String   @id @db.Char(64)
  firstSeenAt  DateTime @db.DateTime(3)
  lastSeenAt   DateTime @db.DateTime(3)
  sessionCount Int      @db.UnsignedInt

  @@index([lastSeenAt])
}

// One visit: attributes come from its first page view; counters advance with later events.
model AnalyticsSession {
  id             String   @id @db.Char(36)
  visitorId      String   @db.Char(64)
  startedAt      DateTime @db.DateTime(3)
  lastSeenAt     DateTime @db.DateTime(3)
  isNewVisitor   Boolean
  visitNumber    Int      @db.UnsignedInt
  entryPath      String   @db.VarChar(512)
  entryRoute     String   @db.VarChar(128)
  exitPath       String   @db.VarChar(512)
  exitRoute      String   @db.VarChar(128)
  pageviews      Int      @db.UnsignedInt
  interactions   Int      @db.UnsignedInt
  engagedMs      Int      @db.UnsignedInt
  converted      Boolean
  channel        String   @db.VarChar(24)
  referrerHost   String?  @db.VarChar(255)
  utmSource      String?  @db.VarChar(100)
  utmMedium      String?  @db.VarChar(100)
  utmCampaign    String?  @db.VarChar(100)
  utmTerm        String?  @db.VarChar(100)
  utmContent     String?  @db.VarChar(100)
  deviceType     String   @db.VarChar(16)
  browser        String   @db.VarChar(32)
  browserVersion String?  @db.VarChar(16)
  os             String   @db.VarChar(32)
  osVersion      String?  @db.VarChar(16)
  country        String?  @db.Char(2)
  city           String?  @db.VarChar(96)
  geoSource      String   @db.VarChar(16)
  language       String?  @db.VarChar(16)
  screen         String?  @db.VarChar(16)

  @@index([startedAt])
  @@index([lastSeenAt])
  @@index([visitorId, startedAt])
}

model AnalyticsPageview {
  id           String   @id @db.Char(36)
  sessionId    String   @db.Char(36)
  visitorId    String   @db.Char(64)
  occurredAt   DateTime @db.DateTime(3)
  sequence     Int      @db.UnsignedInt
  path         String   @db.VarChar(512)
  route        String   @db.VarChar(128)
  title        String?  @db.VarChar(200)
  previousPath String?  @db.VarChar(512)
  engagedMs    Int      @db.UnsignedInt

  @@index([occurredAt])
  @@index([sessionId, sequence])
}

// Clicks, outbound links, downloads, searches, custom events and deduplicated goal conversions.
model AnalyticsEvent {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  sessionId  String   @db.Char(36)
  visitorId  String   @db.Char(64)
  pageviewId String?  @db.Char(36)
  occurredAt DateTime @db.DateTime(3)
  type       String   @db.VarChar(16)
  name       String   @db.VarChar(160)
  path       String   @db.VarChar(512)
  target     String?  @db.VarChar(512)

  @@index([occurredAt, type])
  @@index([sessionId, type])
}

// Dashboard sign-ins: only a SHA-256 of each random session token is stored.
model AnalyticsAdminSession {
  tokenHash  String   @id @db.Char(64)
  username   String   @db.VarChar(64)
  createdAt  DateTime @db.DateTime(3)
  lastSeenAt DateTime @db.DateTime(3)
  expiresAt  DateTime @db.DateTime(3)

  @@index([expiresAt])
}

// Failed sign-in counters keyed by HMACs of the client address or username; never the raw values.
model AnalyticsLoginThrottle {
  key             String    @id @db.Char(64)
  failures        Int       @db.UnsignedInt
  windowStartedAt DateTime  @db.DateTime(3)
  lockedUntil     DateTime? @db.DateTime(3)

  @@index([windowStartedAt])
}

// Owner-adjustable analytics settings, such as the retention period and the last purge time.
model AnalyticsSetting {
  key       String   @id @db.VarChar(64)
  value     String   @db.VarChar(256)
  updatedAt DateTime @db.DateTime(3)
}

// Paid access (prompts/monetization.md 5.1). Phones are canonical digits (`256772123456`, src/domain/phone.ts); session
// tokens and codes are stored only as hashes. Instants are UTC. The switch in SubscriptionSettings stays off by default.
// A phone-number account with a salted password hash: no name, email, photo, profile or user agent. The number is unique and not
// hashed, because the owner matches payers by number; erasure sets it NULL with erasedAt and keeps the row for its payment
// and code records. Every account change locks this row first. creditUgx caches the newest WalletEntry.balanceAfter and is
// written only with that entry under the account lock; it goes below zero only through a reversal or a transferred debt.
// autoRenew buys autoRenewPlan from credit when a period ends and the balance covers it, under the terms version the member
// accepted when turning it on (autoRenewTermsVersion), which each renewed period records. Number changes are AccountMove rows.
model MemberAccount {
  id               String              @id @db.Char(36)
  phone            String?             @unique @db.VarChar(15)
  passwordHash     String?             @db.VarChar(255)
  phoneVerifiedAt  DateTime?           @db.DateTime(3)
  passwordChangedAt DateTime?          @db.DateTime(3)
  temporaryPasswordHash String?        @db.VarChar(255)
  temporaryPasswordExpiresAt DateTime? @db.DateTime(3)
  passwordResetRequestedAt DateTime?   @db.DateTime(3)
  createdAt        DateTime            @db.DateTime(3)
  lastSignInAt     DateTime            @db.DateTime(3)
  blockedAt        DateTime?           @db.DateTime(3)
  blockedReason    String?             @db.VarChar(200)
  ownerNote        String?             @db.VarChar(500)
  trialRequestedAt DateTime?           @db.DateTime(3)
  trialDismissedAt DateTime?           @db.DateTime(3)
  erasedAt         DateTime?           @db.DateTime(3)
  creditUgx        Int                 @default(0)
  autoRenew        Boolean             @default(false)
  autoRenewPlanId  String?             @db.Char(36)
  autoRenewTermsVersion String?        @db.VarChar(16)
  sessions         MemberSession[]
  submissions      PaymentSubmission[]
  codes            AccessCode[]
  verifications    MemberVerification[]
  walletEntries    WalletEntry[]
  movesFrom        AccountMove[]       @relation("MovesFrom")
  movesTo          AccountMove[]       @relation("MovesTo")
  autoRenewPlan    SubscriptionPlan?   @relation("AutoRenewPlan", fields: [autoRenewPlanId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([passwordResetRequestedAt])
  @@index([autoRenew])
  @@index([autoRenewPlanId])
}

// Member sign-ins: only a SHA-256 of each random session token is stored, with no user agent or address. A signed-in
// session is unlocked by an access period of its own account (068: at approval, grant or sign-in, under the device cap;
// codeEnteredAt is the unlock time); the composite key keeps that period on the session's own account.
model MemberSession {
  tokenHash     String        @id @db.Char(64)
  accountId     String        @db.Char(36)
  createdAt     DateTime      @db.DateTime(3)
  lastSeenAt    DateTime      @db.DateTime(3)
  expiresAt     DateTime      @db.DateTime(3)
  authenticatedAt DateTime?   @db.DateTime(3)
  passwordResetAt DateTime?   @db.DateTime(3)
  adminPasswordVersion String? @db.Char(64)
  codeEnteredAt DateTime?     @db.DateTime(3)
  accessCodeId  String?       @db.Char(36)
  account       MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  accessCode    AccessCode?   @relation(fields: [accessCodeId, accountId], references: [id, accountId], onDelete: Restrict, onUpdate: Restrict, map: "MemberSession_accessCode_fkey")

  @@index([accountId])
  @@index([expiresAt])
  @@index([accessCodeId, accountId])
}

// Single-use account/reset codes. Requests are reserved under the account lock before delivery; HMACs only, never
// plaintext codes. Retain consumed/failed requests until expiry to enforce the rolling 24-hour send allowance.
model MemberVerification {
  id           String         @id @db.Char(36)
  accountId    String?        @db.Char(36)
  phone        String         @db.VarChar(15)
  purpose      String         @db.VarChar(12)
  channel      String         @default("sms") @db.VarChar(8)
  bindingHash  String         @db.Char(64)
  codeHash     String         @db.Char(64)
  proofHash    String?        @db.Char(64)
  attempts     Int            @default(0) @db.UnsignedTinyInt
  createdAt    DateTime       @db.DateTime(3)
  expiresAt    DateTime       @db.DateTime(3)
  sentAt       DateTime?      @db.DateTime(3)
  confirmedAt  DateTime?      @db.DateTime(3)
  consumedAt   DateTime?      @db.DateTime(3)
  account      MemberAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([phone, createdAt])
  @@index([accountId])
  @@index([bindingHash, purpose])
  @@index([expiresAt])
}

// Owner-defined plans, no personal data. Every plan unlocks every feature; plans differ only in length (24-hour blocks
// from activation) and whole-UGX price. Never deleted, only deactivated, because submissions and codes reference them.
model SubscriptionPlan {
  id           String              @id @db.Char(36)
  name         String              @db.VarChar(40)
  durationDays Int                 @db.UnsignedSmallInt
  priceUgx     Int                 @db.UnsignedInt
  active       Boolean
  sortOrder    Int                 @db.UnsignedSmallInt
  createdAt    DateTime            @db.DateTime(3)
  updatedAt    DateTime            @db.DateTime(3)
  submissions  PaymentSubmission[]
  codes        AccessCode[]
  autoRenewers MemberAccount[]     @relation("AutoRenewPlan")
}

// A subscriber's payment report (`report`), or a mobile-money payment the owner recorded with a manual code (`owner`: no
// image, session or terms). Claims are what the subscriber says; the approved columns hold the owner's final values. Plan
// name, days and price are snapshots. payerPhone and rejectText are personal data that erasure clears; amounts and
// transaction IDs stay for accounting. approvedTxnKey (`network:txnKey`) is set only at approval and kept after reversal,
// so one payment is approved at most once; the unique key allows any number of NULLs. purpose `topup` is a credit top-up:
// no plan or days, planName "Account credit", and priceUgx = claimedAmountUgx = the amount the member chose to add.
model PaymentSubmission {
  id                   String             @id @db.Char(36)
  reference            String             @unique @db.Char(4)
  source               String             @db.VarChar(8)
  accountId            String             @db.Char(36)
  purpose              String             @default("plan") @db.VarChar(8)
  planId               String?            @db.Char(36)
  planName             String             @db.VarChar(40)
  durationDays         Int?               @db.UnsignedSmallInt
  priceUgx             Int                @db.UnsignedInt
  payerPhone           String?            @db.VarChar(15)
  claimedNetwork       String             @db.VarChar(8)
  claimedTxnRef        String?            @db.VarChar(40)
  claimedTxnKey        String?            @db.VarChar(40)
  claimedAmountUgx     Int                @db.UnsignedInt
  /// The amount the member's browser read from the screenshot: a hint for the owner's review, never the claim.
  screenshotAmountUgx  Int?               @db.UnsignedInt
  status               String             @db.VarChar(16)
  submittedAt          DateTime           @db.DateTime(3)
  submittedSessionHash String?            @db.Char(64)
  termsVersion         String?            @db.VarChar(16)
  acceptedAt           DateTime?          @db.DateTime(3)
  decidedAt            DateTime?          @db.DateTime(3)
  decidedBy            String?            @db.VarChar(64)
  rejectReason         String?            @db.VarChar(16)
  rejectText           String?            @db.VarChar(200)
  network              String?            @db.VarChar(8)
  transactionRef       String?            @db.VarChar(40)
  amountReceivedUgx    Int?               @db.UnsignedInt
  approvedTxnKey       String?            @unique @db.VarChar(48)
  imageSha256          String?            @db.Char(64)
  imageBytes           Int?               @db.UnsignedInt
  imagePurgedAt        DateTime?          @db.DateTime(3)
  reversedAt           DateTime?          @db.DateTime(3)
  reverseReason        String?            @db.VarChar(16)
  account              MemberAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  plan                 SubscriptionPlan?  @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  screenshot           PaymentScreenshot?
  code                 AccessCode?
  walletEntries        WalletEntry[]

  @@unique([id, accountId])
  @@index([claimedTxnKey])
  @@index([status, submittedAt])
  @@index([accountId, submittedAt])
  @@index([imageSha256])
  @@index([planId])
}

// Screenshot bytes (JPEG only), apart from the submission so lists never load them. Served only to the owner; the members
// purge deletes them 90 days after approval or 7 after rejection or supersede, and erasure deletes them at once.
model PaymentScreenshot {
  submissionId String            @id @db.Char(36)
  width        Int               @db.UnsignedSmallInt
  height       Int               @db.UnsignedSmallInt
  bytes        Int               @db.UnsignedInt
  data         Bytes             @db.MediumBlob
  submission   PaymentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
}

// Access periods, each bound to one account (068: no code is sent or entered). The NOT NULL code columns hold a salted
// SHA-256 of a random code that is never shown or kept (a random salt per row, no key). The period (activatedAt,
// startsAt, endsAt) is set when the row is created, at payment approval or an owner grant. Plan name, days and price are
// snapshots (price 0 for trial and number-change periods). replacedById points from an earlier reissued or
// number-changed period to its successor.
model AccessCode {
  id                  String             @id @db.Char(36)
  accountId           String             @db.Char(36)
  codeSalt            Bytes              @db.Binary(16)
  codeHash            String             @db.Char(64)
  reference           String             @unique @db.Char(4)
  source              String             @db.VarChar(16)
  paymentSubmissionId String?            @unique @db.Char(36)
  replacedById        String?            @db.Char(36)
  planId              String?            @db.Char(36)
  planName            String             @db.VarChar(40)
  durationDays        Int                @db.UnsignedSmallInt
  priceUgx            Int                @db.UnsignedInt
  amountReceivedUgx   Int?               @db.UnsignedInt
  extensionDays       Int                @default(0) @db.UnsignedSmallInt
  createdAt           DateTime           @db.DateTime(3)
  createdBy           String             @db.VarChar(64)
  activatedAt         DateTime           @db.DateTime(3)
  startsAt            DateTime           @db.DateTime(3)
  endsAt              DateTime           @db.DateTime(3)
  termsVersion        String?            @db.VarChar(16)
  revokedAt           DateTime?          @db.DateTime(3)
  revokedReason       String?            @db.VarChar(32)
  note                String?            @db.VarChar(200)
  account             MemberAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  paymentSubmission   PaymentSubmission? @relation(fields: [paymentSubmissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replacedBy          AccessCode?        @relation("AccessCodeReplacement", fields: [replacedById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replaces            AccessCode[]       @relation("AccessCodeReplacement")
  plan                SubscriptionPlan?  @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessions            MemberSession[]
  walletEntry         WalletEntry?

  @@unique([id, accountId])
  @@index([accountId, endsAt])
  @@index([replacedById])
  @@index([planId])
}

// Account credit (plan-only, non-refundable): an append-only ledger with one row per change, kept on its own account by
// composite keys; the database refuses updates and deletes, and permanent deletion removes rows by foreign-key cascade.
// No personal data: actor is a role (admin, member or system) and note a short reason without long numbers. entryNumber
// counts 1, 2, … per account, so a stale balance read fails on the unique key instead of losing an update. requestKey
// makes a purchase or renewal idempotent.
model WalletEntry {
  id                  String             @id @db.Char(36)
  accountId           String             @db.Char(36)
  entryNumber         Int                @db.UnsignedInt
  kind                String             @db.VarChar(12)
  amountUgx           Int
  balanceAfter        Int
  paymentSubmissionId String?            @db.Char(36)
  accessCodeId        String?            @db.Char(36)
  requestKey          String?            @unique @db.VarChar(80)
  actor               String             @db.VarChar(8)
  note                String?            @db.VarChar(200)
  createdAt           DateTime           @db.DateTime(3)
  account             MemberAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  paymentSubmission   PaymentSubmission? @relation(fields: [paymentSubmissionId, accountId], references: [id, accountId], onDelete: Cascade, onUpdate: Restrict, map: "WalletEntry_paymentSubmission_fkey")
  accessCode          AccessCode?        @relation(fields: [accessCodeId, accountId], references: [id, accountId], onDelete: Cascade, onUpdate: Restrict, map: "WalletEntry_accessCode_fkey")

  @@unique([accountId, entryNumber])
  @@unique([paymentSubmissionId, accountId, kind])
  @@unique([accessCodeId, accountId])
  @@index([accountId, createdAt])
}

// A number change: the person moved from one account to another, which carried the whole balance and access. Append-only
// (the database refuses updates and deletes, and an account with moves cannot be deleted, only erased). sequence orders moves
// exactly: two moves touching one account serialize on its lock. fromEntryNumber is the old account's newest ledger entry when
// it moved, so credit at or before it moved. A reversal walks these rows to find who holds a payment's credit now.
model AccountMove {
  sequence        BigInt        @id @default(autoincrement())
  fromAccountId   String        @db.Char(36)
  toAccountId     String        @db.Char(36)
  fromEntryNumber Int           @db.UnsignedInt
  movedAt         DateTime      @db.DateTime(3)
  fromAccount     MemberAccount @relation("MovesFrom", fields: [fromAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  toAccount       MemberAccount @relation("MovesTo", fields: [toAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([fromAccountId, sequence])
  @@index([toAccountId])
}

// The owner's paid-access settings: a single row, id = 1, and a missing row means these defaults (paywallMode off). The
// numbers are the owner's own payment, contact and WhatsApp numbers (canonical digits) with registered names, entered on
// the dashboard; never a subscriber's.
model SubscriptionSettings {
  id                      Int       @id @db.UnsignedTinyInt
  paywallMode             String    @default("off") @db.VarChar(8)
  mtnNumber               String?   @db.VarChar(15)
  mtnName                 String?   @db.VarChar(64)
  mtnMenuShortcut         String?   @db.VarChar(60)
  airtelNumber            String?   @db.VarChar(15)
  airtelName              String?   @db.VarChar(64)
  airtelMenuShortcut      String?   @db.VarChar(60)
  copyFormat              String    @default("international") @db.VarChar(16)
  contactPhone            String?   @db.VarChar(15)
  whatsappPhone           String?   @db.VarChar(15)
  paymentNote             String?   @db.VarChar(300)
  reviewTime              String?   @db.VarChar(60)
  maxUnlockedDevices      Int       @default(2) @db.UnsignedTinyInt
  trialDays               Int       @default(2) @db.UnsignedTinyInt
  screenshotRetentionDays Int       @default(90) @db.UnsignedSmallInt
  paymentNumbersChangedAt DateTime? @db.DateTime(3)
  lastMembersPurgeAt      DateTime? @db.DateTime(3)
  updatedAt               DateTime  @db.DateTime(3)
  updatedBy               String    @db.VarChar(64)
}

// Throttle counters keyed by an HMAC of purpose and value (address, session or account); never the raw value. Written only
// by one atomic INSERT ... ON DUPLICATE KEY UPDATE, never read-then-create like AnalyticsLoginThrottle, which races.
model RateLimitBucket {
  key             String    @id @db.Char(64)
  count           Int       @default(0) @db.UnsignedInt
  bytes           Int       @default(0) @db.UnsignedInt
  windowStartedAt DateTime  @db.DateTime(3)
  lockedUntil     DateTime? @db.DateTime(3)
}

// Owner actions and sign-ins. Never a subscriber phone, a full code or an image in details. accountId has no foreign key,
// so rows outlive a purged account. Operational, not tamper-proof: the application role writes it.
model OwnerAuditEvent {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  at         DateTime @db.DateTime(3)
  actor      String   @db.VarChar(64)
  action     String   @db.VarChar(48)
  accountId  String?  @db.Char(36)
  targetType String   @db.VarChar(32)
  targetId   String   @db.VarChar(64)
  details    Json

  @@index([accountId, action, at])
}

// Existing locally collected match facts are adopted without rewriting their rows.
model FixtureFacts {
  fixtureId String @id @db.Char(36)
  providerFixtureId BigInt @db.UnsignedBigInt
  venueExternalId BigInt? @db.UnsignedBigInt
  venueName String? @db.VarChar(256)
  venueCity String? @db.VarChar(256)
  referee String? @db.VarChar(256)
  infoRetrievedAt DateTime? @db.DateTime(3)
  events Json?
  eventsHash String? @db.Char(64)
  eventsRetrievedAt DateTime? @db.DateTime(3)
  statistics Json?
  statisticsHash String? @db.Char(64)
  statisticsRetrievedAt DateTime? @db.DateTime(3)
  updatedAt DateTime @db.DateTime(3)
  fixture FootballFixture @relation(fields: [fixtureId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([venueExternalId])
}

model FootballVenue {
  provider String @db.VarChar(32)
  externalId BigInt @db.UnsignedBigInt
  status String @db.VarChar(16)
  name String? @db.VarChar(256)
  city String? @db.VarChar(256)
  country String? @db.VarChar(256)
  capacity Int? @db.UnsignedInt
  surface String? @db.VarChar(64)
  retrievedAt DateTime? @db.DateTime(3)
  checkedAt DateTime @db.DateTime(3)
  @@id([provider, externalId])
  @@index([checkedAt])
}

model SeasonStandings {
  seasonId String @id @db.Char(36)
  status String @db.VarChar(16)
  body Json?
  contentHash String? @db.Char(64)
  retrievedAt DateTime? @db.DateTime(3)
  checkedAt DateTime @db.DateTime(3)
  season FootballSeason @relation(fields: [seasonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([checkedAt])
}
