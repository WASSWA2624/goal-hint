{
  "name": "goal-hint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.1",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "nodemon",
    "build": "next build && node scripts/build-offline-manifest.mjs",
    "start": "next start",
    "package:cpanel": "python scripts/package-cpanel.py",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "postinstall": "npm run db:generate && node scripts/ocr-assets.mjs",
    "db:generate": "python scripts/database.py generate",
    "db:validate": "python scripts/database.py validate",
    "db:migrate": "python scripts/database.py migrate",
    "db:deploy": "python scripts/database.py deploy",
    "db:status": "python scripts/database.py status",
    "db:verify": "python scripts/database.py verify",
    "db:health": "python scripts/database-health.py",
    "db:storage": "python scripts/database-storage.py",
    "test:storage": "node --conditions=react-server --test tests/database-storage.test.mjs tests/database-storage.integration.mjs",
    "db:compaction-report": "python scripts/database-compaction-report.py",
    "test:compaction": "node --conditions=react-server --test tests/history-compaction.test.mjs tests/history-compaction.integration.mjs",
    "test:db": "node --conditions=react-server --test tests/database.integration.mjs",
    "test:quota": "node --conditions=react-server --test tests/quota.integration.mjs",
    "test:catalog": "node --conditions=react-server --test tests/catalog.integration.mjs",
    "test:cost": "node --conditions=react-server --test tests/cost.integration.mjs",
    "test:evidence": "node --conditions=react-server --test tests/evidence.integration.mjs",
    "test:predictor": "node --conditions=react-server --test tests/predictor.integration.mjs",
    "policy:check": "python scripts/check-runtime-policy.py",
    "trial:football": "python scripts/football-provider-trial.py",
    "evaluation:report": "python scripts/forecast-evaluation.py",
    "test:styling": "python scripts/verify-brand-rendering.py",
    "test:navigation": "node --conditions=react-server --test tests/navigation.test.mjs",
    "test:navigation:html": "python scripts/verify-navigation-rendering.py",
    "test:state": "node --conditions=react-server --test tests/feed-query.test.mjs tests/feed-controls.test.mjs tests/feed-pagination.test.mjs tests/client-state.test.mjs",
    "test:state:rendering": "python scripts/verify-client-state-rendering.py",
    "test:card": "node --conditions=react-server --test tests/match-card.test.mjs",
    "test:card:rendering": "python scripts/verify-match-card-rendering.py",
    "test:history": "node --conditions=react-server --test tests/prediction-history.test.mjs tests/prediction-history.integration.mjs",
    "test:jobs": "node --conditions=react-server --test tests/durable-jobs.test.mjs tests/durable-jobs.integration.mjs",
    "test:selection": "node --conditions=react-server --test tests/daily-selection.test.mjs tests/daily-selection.integration.mjs",
    "test:publication": "node --conditions=react-server --test tests/revision-publication.test.mjs tests/revision-publication.integration.mjs",
    "test:cutoff": "node --conditions=react-server --test tests/cutoff-locking.test.mjs tests/cutoff-locking.integration.mjs",
    "test:lifecycle": "node --conditions=react-server --test tests/schedule-lifecycle.test.mjs tests/schedule-lifecycle.integration.mjs",
    "test:refresh": "node --conditions=react-server --test tests/prediction-refresh.test.mjs tests/prediction-refresh.integration.mjs",
    "test:prediction-engine:mysql": "node --conditions=react-server scripts/test-prediction-engine-mysql.mjs",
    "worker:jobs": "node --conditions=react-server --env-file-if-exists=.env.local src/workers/jobs.ts",
    "worker:results": "node --conditions=react-server --env-file-if-exists=.env.local src/workers/results.ts",
    "worker:slips": "node --conditions=react-server --env-file-if-exists=.env.local --env-file-if-exists=.env.operations src/workers/slips.ts",
    "test:publications": "node --conditions=react-server --test --test-concurrency=1 tests/published-slips.test.mjs tests/published-slips.integration.mjs tests/slip-forecast.test.mjs tests/saved-slips.test.mjs",
    "live": "node --conditions=react-server --env-file-if-exists=.env.local --env-file-if-exists=.env.operations src/workers/live.ts",
    "live:competitions": "python scripts/live-competitions.py",
    "live:status": "python scripts/live-status.py",
    "test:live": "node --conditions=react-server --test tests/live-binding.test.mjs",
    "test:live-details": "node --conditions=react-server --test --test-concurrency=1 tests/live-match.test.mjs tests/live-match-read.test.mjs tests/live-detail-quota.test.mjs tests/quota-priority-counts.test.mjs tests/live-match-store.integration.mjs",
    "recovery": "node --conditions=react-server --env-file-if-exists=.env.local src/workers/recovery.ts",
    "test:recovery": "node --conditions=react-server --test tests/recovery-watchdog.test.mjs tests/recovery-watchdog.integration.mjs",
    "monitoring": "node --conditions=react-server --env-file-if-exists=.env.local src/workers/monitoring.ts",
    "test:monitoring": "node --conditions=react-server --test --test-isolation=none --test-concurrency=1 tests/operations-monitoring.test.mjs tests/operations-monitoring.integration.mjs",
    "test:monitoring:overhead": "python scripts/verify-monitoring-overhead.py",
    "backup": "python scripts/backup.py",
    "test:backup": "node --conditions=react-server --test --test-concurrency=1 tests/backup-restore.test.mjs tests/backup-restore.integration.mjs",
    "test:results": "node --conditions=react-server --test tests/result-sync.test.mjs tests/result-sync-empty.test.mjs tests/result-sync.integration.mjs",
    "test:settlement": "node --conditions=react-server --test tests/market-settlement.test.mjs tests/market-settlement.integration.mjs",
    "test:odds": "node --conditions=react-server --test tests/odds.test.mjs tests/odds-import.test.mjs tests/odds.integration.mjs",
    "test:slips": "node --conditions=react-server --test tests/slip-builder.test.mjs tests/joint-slips.test.mjs tests/best-slips.test.mjs tests/slip-price-page.test.mjs tests/slip-service.test.mjs tests/slip-forecast.test.mjs tests/saved-slips.test.mjs tests/saved-slips.integration.mjs",
    "test:slips:rendering": "python scripts/verify-slip-rendering.py",
    "test:team-codes": "node --conditions=react-server --test tests/team-codes.test.mjs tests/team-name.test.mjs tests/team-codes.integration.mjs",
    "test:feed": "node --conditions=react-server --test tests/match-feed.test.mjs tests/match-feed.integration.mjs",
    "test:detail": "node --conditions=react-server --test tests/match-detail.test.mjs tests/match-detail.integration.mjs",
    "test:performance": "node --conditions=react-server --test tests/pick-performance.test.mjs tests/performance-quotes.test.mjs tests/performance-quotes.integration.mjs tests/prediction-quote-store.test.mjs tests/performance.test.mjs tests/performance.integration.mjs tests/prediction-quotes.integration.mjs",
    "test": "node --conditions=react-server --test tests/*.test.mjs",
    "check": "npm run db:generate && npm run db:validate && npm run lint && npm run typecheck && npm test && npm run test:scripts && npm run build",
    "test:cache": "node --conditions=react-server --test tests/public-cache.test.mjs tests/public-cache.integration.mjs",
    "cache:reconcile": "python scripts/public-cache-reconcile.py",
    "test:feed-page": "node --conditions=react-server --test tests/feed-page.test.mjs tests/feed-page.integration.mjs",
    "test:feed-page:rendering": "python scripts/verify-match-feed-rendering.py",
    "test:detail-page": "node --conditions=react-server --test tests/match-detail-page.test.mjs",
    "test:detail-page:rendering": "python scripts/verify-match-feed-rendering.py --detail",
    "test:history-page": "node --conditions=react-server --test tests/match-detail-page.test.mjs tests/revision-history-page.test.mjs",
    "test:history-page:rendering": "python scripts/verify-match-feed-rendering.py --history",
    "test:live-client": "node --conditions=react-server --test tests/live-client-refresh.test.mjs tests/feed-pagination.test.mjs tests/client-state.test.mjs",
    "test:live-client:rendering": "python scripts/verify-match-feed-rendering.py --live",
    "test:privacy:html": "python scripts/verify-privacy-rendering.py",
    "test:terms:html": "python scripts/verify-terms-rendering.py",
    "test:contact:html": "python scripts/verify-contact-rendering.py",
    "test:seo": "node --conditions=react-server --test tests/discovery.test.mjs tests/match-detail-metadata.test.mjs tests/metadata-recovery.test.mjs tests/seo-card-links.test.mjs tests/seo-status-calendar.test.mjs tests/seo-metadata.test.mjs tests/seo-match-links.test.mjs tests/seo-performance.test.mjs tests/discovery.integration.mjs",
    "test:seo:rendering": "python scripts/verify-seo-rendering.py",
    "analytics:hash-password": "node --conditions=react-server src/workers/analytics.ts hash-password",
    "members:purge": "node --conditions=react-server --env-file-if-exists=.env.local src/workers/members.ts purge",
    "members:renew": "node --conditions=react-server --env-file-if-exists=.env.local src/workers/members.ts renew",
    "payments:notifications": "node --conditions=react-server --env-file-if-exists=.env.local src/workers/payment-notifications.ts",
    "test:payment-outbox": "node --conditions=react-server --test --test-concurrency=1 tests/payment-outbox.test.mjs tests/payment-outbox.integration.mjs",
    "analytics:purge": "node --conditions=react-server --env-file-if-exists=.env.local src/workers/analytics.ts purge",
    "test:analytics": "node --conditions=react-server --test tests/analytics.test.mjs tests/analytics.integration.mjs",
    "test:admin": "node --conditions=react-server --test tests/admin.test.mjs tests/admin-routes.test.mjs",
    "test:members": "node --conditions=react-server --test --test-concurrency=1 tests/phone.test.mjs tests/access-codes.test.mjs tests/member-auth.test.mjs tests/member-auth.integration.mjs tests/members.test.mjs tests/members.integration.mjs tests/members-admin.integration.mjs",
    "test:scripts": "python -m unittest discover -s tests -p \"*_test.py\"",
    "test:scripts:integration": "python tests/scripts_integration.py",
    "test:payments:rendering": "python scripts/verify-payments-rendering.py",
    "test:payments": "node --conditions=react-server --test --test-concurrency=1 tests/payment-sms.test.mjs tests/payments.test.mjs tests/payments.integration.mjs tests/payments-admin.integration.mjs tests/subscription-packages.integration.mjs tests/wallet.test.mjs tests/wallet.integration.mjs",
    "test:paywall": "node --conditions=react-server --test tests/paywall.test.mjs",
    "test:paywall:rendering": "python scripts/verify-paywall-rendering.py"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "@reduxjs/toolkit": "2.13.0",
    "iso-3166": "4.4.0",
    "libphonenumber-js": "1.13.15",
    "mariadb": "3.5.4",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "9.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "styled-components": "6.5.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "nodemon": "3.1.14",
    "prisma": "7.10.0",
    "tesseract.js": "7.0.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@prisma/adapter-mariadb@7.10.0": {
      "mariadb": "$mariadb"
    },
    "prisma@7.10.0": {
      "mysql2": "3.24.5"
    },
    "@prisma/config@7.10.0": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
