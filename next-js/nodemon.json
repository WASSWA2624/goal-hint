{
  "watch": [
    ".env.development",
    "nodemon.json"
  ],
  "ext": "*",
  "ignore": [
    "**/*.md",
    ".next/**",
    ".tmp/**",
    "node_modules/**",
    "src/server/generated/**"
  ],
  "delay": 300,
  "exec": "node --import ./scripts/local-next-environment.mjs ./node_modules/next/dist/bin/next dev"
}
