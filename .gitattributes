# Keep the pinned third-party source's original formatting intact.
flutter/packages/flutter_inappwebview_windows/** whitespace=-blank-at-eol
# Migration checksums must stay identical on Windows and the MariaDB deployment host.
next-js/prisma/migrations/*/migration.sql text eol=lf
next-js/prisma/mariadb/*.sql text eol=lf
# Passenger activation runs as a shell script on Linux.
next-js/scripts/activate-hosted.sh text eol=lf
