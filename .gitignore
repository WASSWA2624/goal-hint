# Repository-wide local tooling and operating-system files.
.claude/worktrees/
.DS_Store
Thumbs.db
*.log
.playwright-mcp/
.playwright-cli/

# Keep private environment files out of every project.
.env*
!.env.example

# Deployment deliverables and private operator configuration are local only.
/deploy/*.zip
/deploy/*.zip.sha256
/deploy/.staging/
/deploy/.private/

# Each application owns its dependency, build, and runtime ignore rules.
